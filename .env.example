# Environment Configuration for Live Audio Recording Application

# Application Environment
NODE_ENV=development
FLASK_ENV=development

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MySQL Database Configuration
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=audio_db
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=audio_db

# Audio Recording Configuration
AUDIO_UPLOAD_DIR=/app/audio-recordings

# Frontend React App Configuration
REACT_APP_AUDIO_SERVER_URL=http://localhost:3000
REACT_APP_AUDIO_TRANSCRIBER_URL=http://localhost:5555

# Logging Configuration
LOG_LEVEL=debug# Feature Flags
ENABLE_SSL=false
ENABLE_AUTH=false
