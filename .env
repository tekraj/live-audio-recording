# Environment Configuration for Live Audio Recording Application

# Application Environment
NODE_ENV=development
FLASK_ENV=development

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MySQL Database Configuration
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=mauFJcuf5dhRMQrjj
DB_NAME=live_audio_db
MYSQL_DATABASE=live_audio_db
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Audio Recording Configuration
AUDIO_UPLOAD_DIR=/app/audio-recordings

# Frontend React App Configuration
REACT_APP_AUDIO_SERVER_URL=http://localhost/api/
REACT_APP_AUDIO_TRANSCRIBER_URL=http://localhost/transcriber/

# Logging Configuration
LOG_LEVEL=debug

# Feature Flags
ENABLE_SSL=false
ENABLE_AUTH=false
AWS_S3_BUCKET_NAME=audiorecordingtekrajpant
