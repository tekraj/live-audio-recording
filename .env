# Environment Configuration for Live Audio Recording Application

# Application Environment
NODE_ENV=development
FLASK_ENV=development

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MySQL Database Configuration
